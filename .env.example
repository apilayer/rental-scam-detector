# Rental Scam Detector (rentalscamdetector)

# --- Where the tool lives ------------------------------------------------------
# The sub-path the app is served from. Routing, pages, assets and /api calls all hang off it.
# Leave empty locally (the app runs at http://localhost:3000). Next bakes it in at build time,
# so set it before `npm run build`; changing it needs a rebuild.
NEXT_PUBLIC_BASE_PATH=

# The domain the tool is served on, no trailing slash. Used for full URLs only: canonical tags,
# sitemap, share links. Optional; defaults to https://apilayer.com.
NEXT_PUBLIC_SITE_ORIGIN=

# --- API keys (required) -------------------------------------------------------
# Zenserp key, for reverse image search. https://zenserp.com
ZENSERP_API_KEY=

# --- Optional: leave commented out to use the defaults --------------------------
# Per-request timeout in ms
# ZENSERP_TIMEOUT_MS=
# Serve public/ images from a CDN instead of the base path
# NEXT_PUBLIC_ASSET_BASE_URL=
